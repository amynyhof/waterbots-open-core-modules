{
  "name": "@waterbots/violet",
  "version": "0.10.0",
  "private": true,
  "description": "WaterBots open core module: violet (the water-benefit agent). Hosts the VWBA 2.0 D-n methods, starting with D-3, Volume Provided. Not published.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "directory": "packages/violet"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./screen": {
      "types": "./dist/screen.d.ts",
      "default": "./dist/screen.js"
    },
    "./styles.css": "./dist/styles.css",
    "./prompt.md": "./dist/prompt.md",
    "./knowledge.md": "./dist/knowledge.md",
    "./config.yaml": "./dist/config.yaml"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && npm run build:css && npm run build:agent-files",
    "build:css": "node -e \"const fs=require('node:fs');fs.writeFileSync('dist/styles.css', fs.readFileSync(require.resolve('@waterbots/core/report.css'),'utf8') + String.fromCharCode(10) + fs.readFileSync('src/styles.css','utf8'))\"",
    "build:agent-files": "node -e \"for (const f of ['prompt.md', 'knowledge.md', 'config.yaml']) require('node:fs').copyFileSync('src/agents/violet/' + f, 'dist/' + f)\""
  },
  "dependencies": {
    "@waterbots/core": "0.6.x"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
