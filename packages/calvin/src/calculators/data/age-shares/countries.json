{
  "pathway": "cross-cutting",
  "dataset": "age-shares-default",
  "version": "2.0.0",
  "description": "National age-distribution shares (under-5 / 5-18 / 19+) — the DEFAULT split for the Table 9 age-split helper (CALCULATOR_SPEC §3.1.1) when a project lacks age-disaggregated data. FULL COVERAGE: every country the UN WPP source provides. Labelled a default; replaceable by real survey data. Table 9 age tiers applied on household runs under v2.0 from calculator v0.5.0 (Amy's ruling R4, 2026-09-21; [#24]).",
  "registrySources": [
    "un-wpp-2024-pop-age1"
  ],
  "source_year": 2024,
  "variant": "medium",
  "coverage": "All 237 UN WPP 2024 'Country/Area' rows (medium variant, year 2024). Countries absent fall back to globalDefault (output labeled 'global default').",
  "method": "From UN WPP 2024 single-age file (POP/01-1), medium variant, year 2024: under5 = ages 0-4; age5_18 = ages 5-18; adult19plus = ages 19-100+. Exact 18/19 boundary (2026-09-21, replacing the 4:1 split of the 15-19 five-year band used in v1.x).",
  "globalDefault": {
    "under5": 0.0793,
    "age5_18": 0.232,
    "adult19plus": 0.6887,
    "basis": "UN WPP 2024 World aggregate (medium variant, 2024), single-age file, exact 18/19 boundary. Fallback for countries absent from the source; outputs using it are labeled a global default.",
    "cite": "UN WPP 2024 POP/01-1, World row, 2024"
  },
