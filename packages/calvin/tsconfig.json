{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["node"],
    // The seed was typechecked with `strict` only. Two of the base's extra checks flag the seed's code, 95 places
    // in all: unchecked indexed access and exact optional properties. They stay off for this package until the
    // code is brought up to them here, in its own pull request.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noEmit": true
  },
  "include": ["src"]
}
