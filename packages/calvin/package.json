{
  "name": "@waterbots/calvin",
  "version": "0.10.0",
  "private": true,
  "description": "WaterBots open core module: calvin (quantify: the carbon calculator). Arrived with the Calvin seed. Not published.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "directory": "packages/calvin"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    },
    "./screen": {
      "types": "./dist/screen.d.ts",
      "default": "./dist/screen.js"
    },
    "./styles.css": "./dist/styles.css",
    "./prompt.md": "./dist/prompt.md",
    "./knowledge.md": "./dist/knowledge.md",
    "./config.yaml": "./dist/config.yaml"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && npm run build:engine && npm run build:bundles && npm run build:css && npm run build:agent-files",
    "build:engine": "rolldown src/engine.ts --format esm --platform neutral --file dist/engine.js --sourcemap",
    "build:bundles": "rolldown -c rolldown.config.mjs",
    "build:css": "node -e \"const fs=require('node:fs');fs.writeFileSync('dist/styles.css', fs.readFileSync(require.resolve('@waterbots/core/report.css'),'utf8') + String.fromCharCode(10) + fs.readFileSync('src/modules/calvin/styles.css','utf8'))\"",
    "build:agent-files": "node -e \"for (const f of ['prompt.md', 'knowledge.md', 'config.yaml']) require('node:fs').copyFileSync('src/agents/calvin/' + f, 'dist/' + f)\""
  },
  "dependencies": {
    "@waterbots/core": "0.6.x"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
