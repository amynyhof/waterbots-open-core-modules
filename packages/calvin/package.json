{
  "name": "@waterbots/calvin",
  "version": "0.2.0",
  "private": true,
  "description": "WaterBots open core module: calvin (quantify: the carbon calculator). Arrived with the Calvin seed. Not published.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amynyhof/waterbots-open-core-modules.git",
    "directory": "packages/calvin"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./screen": {
      "types": "./dist/screen.d.ts",
      "default": "./dist/screen.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && npm run build:engine && npm run build:screen && npm run build:css",
    "build:engine": "rolldown src/engine.ts --format esm --platform neutral --file dist/engine.js --sourcemap",
    "build:screen": "rolldown -c rolldown.screen.config.mjs",
    "build:css": "node -e \"require('node:fs').copyFileSync('src/modules/calvin/styles.css', 'dist/styles.css')\""
  },
  "dependencies": {
    "@waterbots/core": "0.1.0"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
