{
  "name": "@waterbots/core",
  "version": "0.1.0",
  "private": true,
  "description": "WaterBots open core module: core (what every module shares: the project shape, standards list, save outcome, agent contract). Arrived with the Calvin seed. Not published.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amynyhof/waterbots-open-core-modules.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
